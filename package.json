{
    "name": "link",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite --host 127.0.0.1",
        "build": "vite build",
        "test": "vitest",
        "preview": "vite preview",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check .",
        "codegen": "graphql-codegen --watch",
        "cypress": "npx cypress open",
        "cypress-coverage": "rm -rf coverage .nyc_output ; npx cypress run ; npx nyc report --check-coverage --lines 80",
        "backend": "venv/bin/flask --app backend.app run --port 8000 --debug",
        "dev": "concurrently npm:start npm:test npm:codegen",
        "all": "concurrently npm:backend npm:start npm:test npm:codegen"
    },
    "dependencies": {
        "@apollo/client": "^4.3.5",
        "@fortawesome/free-solid-svg-icons": "^7.3.0",
        "@shish2k/react-faicon": "^0.1.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "react-tooltip": "^6.0.9",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/client-preset": "^6.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "cypress": "^16.2.1",
        "sass": "^1.107.0",
        "typescript": "^7.0",
        "vite": "^8.3",
        "vitest": "^5.0.5"
    }
}
